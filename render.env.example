# =============================================================================
# COPY EVERYTHING BELOW into Render → Web Service → Environment → Bulk Editor
# Replace each REPLACE_ME value. Do not commit real secrets.
# =============================================================================

COOPER_AUTH_MODE=firebase
COOPER_FIREBASE_PROJECT_ID=REPLACE_ME_FIREBASE_PROJECT_ID
COOPER_ORIGIN=https://REPLACE_ME_FIREBASE_SITE.web.app
# Upload the Firebase Admin service-account JSON in Render → Secret Files as
# firebase-admin.json, then point the Admin SDK at Render's mounted secret file.
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-admin.json
COOPER_DATABASE_URL=postgresql+psycopg://postgres.REPLACE_ME_PROJECT_REF:REPLACE_ME_DB_PASSWORD@REPLACE_ME_POOLER_HOST:5432/postgres?sslmode=require
COOPER_TIMEZONE=Asia/Singapore
COOPER_GEMINI_MODEL=gemini-flash-lite-latest

COOPER_OAUTH_STATE_SECRET=REPLACE_ME_OAUTH_STATE_SECRET
COOPER_SYNC_SECRET=REPLACE_ME_SYNC_SECRET
COOPER_ENCRYPTION_KEY=REPLACE_ME_ENCRYPTION_KEY

COOPER_GOOGLE_CLIENT_ID=REPLACE_ME_GOOGLE_CLIENT_ID
COOPER_GOOGLE_CLIENT_SECRET=REPLACE_ME_GOOGLE_CLIENT_SECRET
COOPER_GOOGLE_REDIRECT_URI=https://REPLACE_ME_RENDER_SERVICE.onrender.com/api/google/callback
COOPER_CALENDAR_ID=primary
COOPER_GMAIL_LOOKBACK_DAYS=14
COOPER_GMAIL_POLL_INTERVAL_SECONDS=300

{
  "name": "cooper-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{json,html}\" \"../*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{json,html}\" \"../*.md\"",
    "test": "vitest run",
    "build": "tsc -b && vite build"
  },
  "dependencies": {
    "firebase": "12.18.0",
    "lenis": "1.3.26",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6"
  }
}

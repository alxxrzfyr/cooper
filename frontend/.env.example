# Local development. Leave VITE_COOPER_API empty; Vite proxies /api to 127.0.0.1:8000.
VITE_COOPER_AUTH_MODE=local
VITE_COOPER_API=
VITE_COOPER_KEY=

# Firebase Hosting / public auth. These values are public Firebase client config, not secrets.
# Set VITE_COOPER_AUTH_MODE=firebase with complete config in hosted deployments.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

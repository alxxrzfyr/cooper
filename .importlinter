[importlinter]
root_package = cadence
include_external_packages = True

[importlinter:contract:core-purity]
name = Domain core remains pure
type = forbidden
source_modules =
    cadence.core
forbidden_modules =
    cadence.services
    cadence.adapters
    cadence.api
    sqlalchemy
    fastapi
    pydantic
    pydantic_settings
    alembic
    httpx
    google
    googleapiclient

# Copy to .env and fill in. Never commit .env.

# --- Google Gemini ---
# Key from https://aistudio.google.com/apikey
CADENCE_GEMINI_API_KEY=
# Model IDs live here, never in code. The Gemini lineup changes often.
# Flash-Lite class for intent compilation, Flash class for reranking.
CADENCE_MODEL_COMPILE=gemini-flash-lite-latest
CADENCE_MODEL_RERANK=gemini-flash-latest

# --- Google Calendar OAuth ---
# Web application client. Redirect URI must use 127.0.0.1, not localhost.
CADENCE_GOOGLE_CLIENT_ID=
CADENCE_GOOGLE_CLIENT_SECRET=
CADENCE_GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
# Calendar that receives app-created blocks. A dedicated calendar keeps
# app-owned time visually separable. "primary" is acceptable.
CADENCE_WRITE_CALENDAR_ID=primary
# Comma-separated calendars read for busy time only.
CADENCE_BUSY_CALENDAR_IDS=primary

# --- Secrets ---
# python -c "import secrets; print(secrets.token_urlsafe(32))"
CADENCE_SHARED_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CADENCE_TOKEN_ENCRYPTION_KEY=

# --- Server ---
# Do not change. See docs/SECURITY.md.
CADENCE_HOST=127.0.0.1
CADENCE_PORT=8000
CADENCE_ALLOWED_ORIGIN=http://127.0.0.1:5173
CADENCE_DATABASE_URL=sqlite:///./cadence.db

# --- User context ---
CADENCE_TIMEZONE=Asia/Singapore

# --- Scoring weights. Must sum to 1.0. ---
CADENCE_WEIGHT_DEADLINE=0.35
CADENCE_WEIGHT_IMPORTANCE=0.25
CADENCE_WEIGHT_SLIP=0.15
CADENCE_WEIGHT_UNBLOCKS=0.15
CADENCE_WEIGHT_AGE=0.10
CADENCE_HORIZON_DAYS=14

# --- Placement ---
CADENCE_BLOCK_MIN_MINUTES=25
CADENCE_BLOCK_MAX_MINUTES=90
CADENCE_BLOCK_BUFFER_MINUTES=10
CADENCE_DEFAULT_DAILY_BLOCK_CAP=3
CADENCE_EARLIEST_START_BUFFER_MINUTES=15

# --- Guards ---
CADENCE_MAX_MUTATIONS_PER_TURN=20
CADENCE_MAX_MODEL_CALLS_PER_UTTERANCE=2
CADENCE_RERANK_CANDIDATE_COUNT=10
CADENCE_TITLE_SIMILARITY_THRESHOLD=0.75
CADENCE_TITLE_SIMILARITY_TIE_MARGIN=0.05

# --- Jobs, seconds unless stated ---
CADENCE_OUTBOX_DRAIN_INTERVAL=30
CADENCE_CALENDAR_POLL_INTERVAL=300
CADENCE_TOKEN_HEALTH_INTERVAL=3600
CADENCE_NIGHTLY_PLAN_HOUR_LOCAL=4

# --- Provider selection. Set to rule_based to run with no network. ---
CADENCE_LLM_PROVIDER=gemini

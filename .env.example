# Copy to .env for local development. Only COOPER_SHARED_KEY is required locally.

# Local mode: one machine, one user, SQLite, no network account required.
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
COOPER_SHARED_KEY=
COOPER_AUTH_MODE=local
COOPER_DATABASE_URL=sqlite:///./cooper.db
# Hosted beta option (server-only; never put this URL in frontend configuration):
# COOPER_DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<supabase-pooler-host>:5432/postgres
COOPER_ORIGIN=http://127.0.0.1:5173
COOPER_TIMEZONE=Asia/Singapore

# Hosted mode: Firebase Auth + Cloud Run + PostgreSQL.
# COOPER_SHARED_KEY is ignored when COOPER_AUTH_MODE=firebase.
# Generate OAUTH/SYNC secrets with the same secrets.token_urlsafe command above.
# Put secret values in your host's secret manager, not in git.
# COOPER_AUTH_MODE=firebase
COOPER_FIREBASE_PROJECT_ID=
COOPER_ALLOWED_EMAILS=
# COOPER_ORIGIN=https://<firebase-site>.web.app
# COOPER_DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>/<database>
COOPER_OAUTH_STATE_SECRET=
COOPER_SYNC_SECRET=

# --- Optional: Gemini model name ---
# Gemini keys are entered in the browser Settings screen and sent only with AI messages.
# Without a browser key a rule-based parser handles the common shapes, and ranking and scheduling
# never use a model at all.
COOPER_GEMINI_MODEL=gemini-flash-lite-latest

# --- Optional: Google Calendar + Gmail ---
# Web application OAuth client. Local redirect must use 127.0.0.1, not localhost.
# Hosted redirect is https://<firebase-site>.web.app/api/google/callback and is rewritten to
# Cloud Run by Firebase Hosting.
# Enable the Calendar API and Gmail API. Gmail readonly is restricted; keep an un-published app
# in Testing mode for personal use. Testing-mode refresh tokens expire after seven days.
COOPER_GOOGLE_CLIENT_ID=
COOPER_GOOGLE_CLIENT_SECRET=
COOPER_GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/google/callback
COOPER_CALENDAR_ID=primary
COOPER_GMAIL_LOOKBACK_DAYS=14
# A single Gmail watcher checks on this fixed interval, in seconds.
COOPER_GMAIL_POLL_INTERVAL_SECONDS=300
# Encrypts the refresh token at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
COOPER_ENCRYPTION_KEY=

# Copy to .env. Only CADENCE_SHARED_KEY is required.

# The one required value. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
CADENCE_SHARED_KEY=

CADENCE_TIMEZONE=Asia/Singapore

# --- Optional: better parsing ---
# From https://aistudio.google.com/apikey. Without it a rule-based parser handles
# the common shapes, and ranking and scheduling never use a model at all.
CADENCE_GEMINI_API_KEY=
CADENCE_GEMINI_MODEL=gemini-flash-lite-latest

# --- Optional: Google Calendar ---
# Web application OAuth client. The redirect must use 127.0.0.1, not localhost.
# A consent screen left in Testing mode expires refresh tokens after seven days.
CADENCE_GOOGLE_CLIENT_ID=
CADENCE_GOOGLE_CLIENT_SECRET=
CADENCE_CALENDAR_ID=primary
# Encrypts the refresh token at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CADENCE_ENCRYPTION_KEY=

# Local (required: COOPER_SHARED_KEY >= 24 chars)
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
COOPER_SHARED_KEY=
COOPER_AUTH_MODE=local
COOPER_DATABASE_URL=sqlite:///./cooper.db
COOPER_ORIGIN=http://127.0.0.1:5173
COOPER_TIMEZONE=Asia/Singapore
COOPER_GEMINI_MODEL=gemini-flash-lite-latest

# Included AI (Cooper-funded). Off until every value below is set; startup rejects a
# partial config. Pin exact model IDs (no "latest"). Prices are integer microUSD per
# 1M tokens, e.g. $0.10/M = 100000. See docs/superpowers/plans/2026-10-01-included-ai-implementation.md.
COOPER_INCLUDED_AI_ENABLED=false
COOPER_GEMINI_API_KEY=
COOPER_GROQ_API_KEY=
COOPER_GROQ_MODEL=
COOPER_AI_PRICE_REVISION=
COOPER_GEMINI_INPUT_MICROUSD_PER_MILLION=0
COOPER_GEMINI_OUTPUT_MICROUSD_PER_MILLION=0
COOPER_GROQ_INPUT_MICROUSD_PER_MILLION=0
COOPER_GROQ_OUTPUT_MICROUSD_PER_MILLION=0

# Google Calendar + Gmail (optional locally)
COOPER_GOOGLE_CLIENT_ID=
COOPER_GOOGLE_CLIENT_SECRET=
COOPER_GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/google/callback
COOPER_CALENDAR_ID=primary
COOPER_GMAIL_LOOKBACK_DAYS=14
COOPER_GMAIL_POLL_INTERVAL_SECONDS=300
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
COOPER_ENCRYPTION_KEY=

# Hosted: copy render.env.example into Render → Environment (Bulk Editor).

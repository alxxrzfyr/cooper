# Copy to .env. Only COOPER_SHARED_KEY is required.

# The one required value. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
COOPER_SHARED_KEY=
COOPER_AUTH_MODE=local
COOPER_FIREBASE_PROJECT_ID=
COOPER_ALLOWED_EMAILS=

COOPER_TIMEZONE=Asia/Singapore

# --- Optional: Gemini model name ---
# Gemini keys are entered in the browser Settings screen and sent only with AI messages.
# Without a browser key a rule-based parser handles the common shapes, and ranking and scheduling
# never use a model at all.
COOPER_GEMINI_MODEL=gemini-flash-lite-latest

# --- Optional: Google Calendar + Gmail ---
# Web application OAuth client. The redirect must use 127.0.0.1, not localhost.
# Enable the Calendar API and Gmail API. Gmail readonly is restricted; keep an un-published app
# in Testing mode for personal use. Testing-mode refresh tokens expire after seven days.
COOPER_GOOGLE_CLIENT_ID=
COOPER_GOOGLE_CLIENT_SECRET=
COOPER_CALENDAR_ID=primary
COOPER_GMAIL_LOOKBACK_DAYS=14
# A single Gmail watcher checks on this fixed interval, in seconds.
COOPER_GMAIL_POLL_INTERVAL_SECONDS=300
# Encrypts the refresh token at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
COOPER_ENCRYPTION_KEY=
